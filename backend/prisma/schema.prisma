// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Level {
  level_id             Int      @id @default(autoincrement())
  level_name           String
  min_karma            Int
  max_karma            Int
  borrow_limit         Int
  deposit_discount_pct Float
  created_at           DateTime @default(now())
  users                User[]
}

model User {
  user_id        Int      @id @default(autoincrement())
  email          String   @unique
  password_hash  String?  // Nullable cho Google OAuth
  google_id      String?  @unique
  full_name      String
  avatar         String?
  karma_balance  Int      @default(100) // Welcome bonus 100 Karma
  level_id       Int      @default(1)
  level          Level    @relation(fields: [level_id], references: [level_id])
  is_verified    Boolean  @default(true)
  status         String   @default("ACTIVE")
  last_active_at DateTime?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  items                Item[]
  borrow_requests      BorrowRequest[]  @relation("BorrowerRequests")
  payments             Payments[]
  memberships          Memberships[]
  lenderTransactions   Transaction[]    @relation("LenderTransactions")
  borrowerTransactions Transaction[]    @relation("BorrowerTransactions")
  escrowLogs           EscrowLog[]
}

model Category {
  category_id Int      @id @default(autoincrement())
  name        String   @unique
  icon        String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  items       Item[]

}

model Item {
  item_id     Int      @id @default(autoincrement())
  owner_id    Int
  category_id Int
  title       String
  description String?
  karma_value Int
  type        String
  status      String   @default("AVAILABLE")
  location    String?
  image_url   String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  owner       User     @relation(fields: [owner_id], references: [user_id], onDelete: Cascade)
  category    Category @relation(fields: [category_id], references: [category_id], onDelete: Restrict)
  borrow_requests BorrowRequest[] @relation("ItemBorrowRequests")
  transactions    Transaction[]

  @@index([owner_id])
  @@index([category_id])
  @@index([status])
  @@index([type])
  @@index([created_at])
}

model Admin {
  admin_id      Int       @id @default(autoincrement())
  email         String    @unique
  password_hash String
  full_name     String
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
}

model AdminNotification {
  notification_id Int      @id @default(autoincrement())
  type            String
  title           String
  message         String
  user_id         Int?
  created_at      DateTime @default(now())
  read_at         DateTime?
}

model BorrowRequest {
  request_id  Int      @id @default(autoincrement())
  borrower_id Int
  item_id     Int
  status      String   @default("PENDING")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  borrower    User     @relation("BorrowerRequests", fields: [borrower_id], references: [user_id], onDelete: Cascade)
  item        Item     @relation("ItemBorrowRequests", fields: [item_id], references: [item_id], onDelete: Cascade)

  @@index([status])
  @@index([created_at])
}

// ─────────────────────────────────────────────
// MODULE 3: TRANSACTION & ESCROW/QR (Person 3)
// ─────────────────────────────────────────────

model Transaction {
  trans_id       Int      @id @default(autoincrement())
  item_id        Int
  lender_id      Int
  borrower_id    Int
  karma_amount   Int
  deposit_amount Int      @default(0)
  qr_code_hash   String?
  // PENDING → ESCROW_LOCKED → QR_VERIFIED → COMPLETED
  // PENDING → CANCELLED | QR_VERIFIED → DISPUTED
  status         String   @default("PENDING")
  due_date       DateTime
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  item       Item        @relation(fields: [item_id], references: [item_id])
  lender     User        @relation("LenderTransactions", fields: [lender_id], references: [user_id])
  borrower   User        @relation("BorrowerTransactions", fields: [borrower_id], references: [user_id])
  escrowLogs EscrowLog[]

  @@index([lender_id])
  @@index([borrower_id])
  @@index([status])
  @@index([item_id])
}

model EscrowLog {
  escrow_id    Int      @id @default(autoincrement())
  trans_id     Int
  user_id      Int
  locked_karma Int
  // LOCKED / RELEASED / REFUNDED
  status       String   @default("LOCKED")
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  transaction Transaction @relation(fields: [trans_id], references: [trans_id])
  user        User        @relation(fields: [user_id], references: [user_id])
}

model Payments {
  payment_id      String         @id @default(uuid()) @db.Uuid
  user_id         Int
  amount_vnd      Int
  karma_received  Int            @default(0)
  payment_gateway String
  transaction_ref String         @unique
  purpose         PaymentPurpose
  status          PaymentStatus
  created_at      DateTime       @default(now())
  paid_at         DateTime?
  user            User           @relation(fields: [user_id], references: [user_id])
  membership      Memberships?
}

model Memberships {
  membership_id  String                  @id @default(uuid()) @db.Uuid
  user_id        Int
  payment_id     String?                 @unique @db.Uuid
  plan_type      MembershipPlanType
  payment_method MembershipPaymentMethod
  karma_cost     Int?
  price_vnd      Int?
  start_at       DateTime
  end_at         DateTime
  status         MembershipStatus
  created_at     DateTime                @default(now())
  user           User                    @relation(fields: [user_id], references: [user_id])
  payment        Payments?               @relation(fields: [payment_id], references: [payment_id])
}

model Insurance_Fund_Logs {
  log_id       String   @id @default(uuid()) @db.Uuid
  trans_id     Int
  amount_karma Int
  rate_pct     Decimal
  created_at   DateTime @default(now())
}

enum PaymentPurpose {
  KARMA_TOPUP
  MEMBERSHIP
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum MembershipPlanType {
  KARMA_PASS
}

enum MembershipPaymentMethod {
  PAYOS
  KARMA
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}