// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Level {
  level_id             Int      @id @default(autoincrement())
  level_name           String
  min_karma            Int
  max_karma            Int
  borrow_limit         Int
  deposit_discount_pct Float
  created_at           DateTime @default(now())
  users                User[]
}

model User {
  user_id        Int      @id @default(autoincrement())
  email          String   @unique
  password_hash  String?  // Nullable cho Google OAuth
  google_id      String?  @unique
  full_name      String
  avatar         String?
  karma_balance  Int      @default(100) // Welcome bonus 100 Karma
  level_id       Int      @default(1)
  level          Level    @relation(fields: [level_id], references: [level_id])
  is_verified    Boolean  @default(true)
  status         String   @default("ACTIVE")
  last_active_at DateTime?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  items          Item[]
  borrow_requests BorrowRequest[] @relation("BorrowerRequests")
}

model Category {
  category_id Int      @id @default(autoincrement())
  name        String   @unique
  icon        String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  items       Item[]

}

model Item {
  item_id     Int      @id @default(autoincrement())
  owner_id    Int
  category_id Int
  title       String
  description String?
  karma_value Int
  type        String
  status      String   @default("AVAILABLE")
  location    String?
  image_url   String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  owner       User     @relation(fields: [owner_id], references: [user_id], onDelete: Cascade)
  category    Category @relation(fields: [category_id], references: [category_id], onDelete: Restrict)
  borrow_requests BorrowRequest[] @relation("ItemBorrowRequests")

  @@index([owner_id])
  @@index([category_id])
  @@index([status])
  @@index([type])
  @@index([created_at])
}

model Admin {
  admin_id      Int       @id @default(autoincrement())
  email         String    @unique
  password_hash String
  full_name     String
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
}

model AdminNotification {
  notification_id Int      @id @default(autoincrement())
  type            String
  title           String
  message         String
  user_id         Int?
  created_at      DateTime @default(now())
  read_at         DateTime?
}

model BorrowRequest {
  request_id  Int      @id @default(autoincrement())
  borrower_id Int
  item_id     Int
  status      String   @default("PENDING")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  borrower    User     @relation("BorrowerRequests", fields: [borrower_id], references: [user_id], onDelete: Cascade)
  item        Item     @relation("ItemBorrowRequests", fields: [item_id], references: [item_id], onDelete: Cascade)

  @@index([status])
  @@index([created_at])
}
